[Unit]
Description=PCC2K-Agent — outbound RMM agent
Documentation=https://github.com/michaelsaville/pcc2k-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/pcc2k-agent.env
ExecStart=/usr/local/bin/pcc2k-agent --gateway ${PCC2K_GATEWAY_URL} --insecure
Restart=on-failure
RestartSec=5s

# Phase v1.0.2 — flipped to root. shell.open / file.push / backup.trigger
# / fleet.services.start/stop/restart all require root to spawn child
# processes against arbitrary system services. Read-only inventory used
# to be enough; control verbs are not.
User=root
Group=root

# Hardening reduced to match the wider verb surface. ProtectSystem=
# strict would block backup.trigger writing log files under
# /var/lib/pcc2k-agent/backups/; ProtectHome=read-only would block
# RustDesk peer-id reads from operator home dirs.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
